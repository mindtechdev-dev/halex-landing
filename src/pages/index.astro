---
import '../styles/styles.css';
import { readFileSync } from 'fs';
import { fileURLToPath } from 'url';
import path from 'path';

const __dirname = path.dirname(fileURLToPath(import.meta.url));
const appJs  = readFileSync(path.resolve(__dirname, '../../public/app.js'),  'utf8');
const pageCss = readFileSync(path.resolve(__dirname, '../../public/page.css'), 'utf8');
---

<!DOCTYPE html>
<html lang="es">
<head>
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<title>HALEX – Soluciones reales para tu hogar o negocio</title>
<meta name="description" content="Obras menores en construcción y servicios: techumbres, gasfitería, pintura, electricidad menor y mantenciones para hogares y negocios." />
<link rel="icon" href="/assets/halex-logo.png" />
<style is:inline set:html={pageCss}></style>
</head>
<body>
<div id="root"></div>
<script is:inline src="https://unpkg.com/react@18.3.1/umd/react.production.min.js" crossorigin="anonymous"></script>
<script is:inline src="https://unpkg.com/react-dom@18.3.1/umd/react-dom.production.min.js" crossorigin="anonymous"></script>
<script is:inline src="https://unpkg.com/@babel/standalone@7.29.0/babel.min.js" crossorigin="anonymous"></script>
<script is:inline src="/image-slot.js"></script>
<script is:inline type="text/babel" data-presets="react" set:html={appJs}></script>
</body>
</html>
