import '../styles/styles.css';
---
<!DOCTYPE html>
<html lang="es">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<!-- Google tag (gtag.js) -->
<script is:inline async src="https://www.googletagmanager.com/gtag/js?id=AW-18520884552"></script>
<script is:inline>
  window.dataLayer = window.dataLayer || [];
  function gtag(){dataLayer.push(arguments);}
  gtag('js', new Date());
  gtag('config', 'AW-18520884552');
</script>
<!-- Conversiones HALEX: se disparan solo al hacer clic -->
<script is:inline>
(function(){
  var CONV = {
    whatsapp: 'AW-18520884552/X7KECLyt4qMdEMiKuf9E', // Solicitar cotización
    correo: ''  // PENDIENTE: pegar aquí la etiqueta de la conversión "Clic en correo" (AW-18520884552/xxxx)
  };
  function halexConv(tipo){
    var id = CONV[tipo];
    if (!id || typeof gtag !== 'function') return;
    gtag('event', 'conversion', { send_to: id });
  }
  window.halexConv = halexConv;
  document.addEventListener('click', function(e){
    var a = e.target.closest && e.target.closest('a[href]');
    if (!a) return;
    var h = a.getAttribute('href') || '';
    if (/wa\.me\/|api\.whatsapp\.com/.test(h)) halexConv('whatsapp');
    else if (/^mailto:/i.test(h)) halexConv('correo');
  }, true);
})();
</script>
<title>HALEX — Soluciones reales para tu hogar o negocio</title>
<meta name="description" content="Obras menores en construcción y servicios. Reparación de techumbres, gasfitería, pintura, electricidad menor y mantenciones para hogares y negocios.">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Archivo:wght@500;600;700;800;900&family=Hanken+Grotesk:wght@400;500;600;700&display=swap">
<link rel="stylesheet" href="/page.css">
</head>
<body>
<div id="root"></div>
<script is:inline src="https://unpkg.com/react@18.3.1/umd/react.production.min.js"></script>
<script is:inline src="https://unpkg.com/react-dom@18.3.1/umd/react-dom.production.min.js"></script>
<script is:inline src="https://unpkg.com/@babel/standalone@7.29.0/babel.min.js"></script>
<script is:inline type="text/babel" data-presets="react" src="/app.jsx"></script>
</body>
</html>
