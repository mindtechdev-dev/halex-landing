import '../styles/styles.css';
const pageCss = "\n  html { scroll-behavior: smooth; }\n  body { background: var(--ink-950); }\n  .navlink:hover { color: var(--gold-500) !important; }\n  .foot-link:hover { color: var(--gold-500) !important; }\n  a { text-decoration: none; }\n\n  /* Trabajos reales */\n  .tr-toggle{width:100%;display:flex;align-items:center;justify-content:space-between;gap:24px;background:transparent;border:0;border-bottom:1px solid var(--border-dark);padding:0 0 24px;cursor:pointer;text-align:left;color:inherit;font-family:inherit}\n  .tr-toggle-text{display:flex;flex-direction:column;gap:12px}\n  .tr-eyebrow{font-weight:700;font-size:.8125rem;letter-spacing:.18em;text-transform:uppercase;color:var(--gold-500)}\n  .tr-title{font-family:var(--font-display);font-weight:800;font-size:var(--fs-h2);line-height:1.1;letter-spacing:-.01em;color:#fff}\n  .tr-chevron{position:relative;flex-shrink:0;width:52px;height:52px;display:inline-flex;align-items:center;justify-content:center;border-radius:999px;border:1px solid var(--border-dark);background:rgba(255,255,255,.04);color:#fff;font-size:19px;transition:border-color .22s,background .22s}\n  .tr-arrow{position:relative;z-index:2;display:inline-block;transform:rotate(90deg);transition:transform .38s cubic-bezier(.22,1,.36,1)}\n  .tr-toggle[aria-expanded=\"true\"] .tr-arrow{transform:rotate(-90deg)}\n  .tr-wave{position:absolute;inset:0;border-radius:999px;border:1.5px solid rgba(255,255,255,.85);opacity:0;animation:trPulse 2.2s cubic-bezier(.22,1,.36,1) infinite}\n  .tr-wave--2{animation-delay:1.1s}\n  .tr-toggle[aria-expanded=\"true\"] .tr-wave{animation:none;opacity:0}\n  @keyframes trPulse{0%{transform:scale(1);opacity:.85}70%{transform:scale(1.85);opacity:0}100%{transform:scale(1.85);opacity:0}}\n  @media(prefers-reduced-motion:reduce){.tr-wave{animation:none}}\n  .tr-hint{font-size:14px;color:var(--gray-400);font-weight:500}\n  .tr-toggle[aria-expanded=\"true\"] .tr-hint{color:var(--gold-500)}\n  .tr-toggle:hover .tr-chevron{border-color:var(--border-gold);background:rgba(232,182,46,.1)}\n  .tr-panel{display:grid;grid-template-rows:1fr;transition:grid-template-rows .38s cubic-bezier(.22,1,.36,1)}\n  .tr-panel>*{min-height:0}\n  .tr-panel.collapsed{grid-template-rows:0fr}\n  .tr-panel.collapsed>*{overflow:hidden;visibility:hidden}\n  .tr-intro{font-size:var(--fs-lead);line-height:1.6;color:var(--gray-300);margin:32px 0 0;max-width:680px}\n  .tr-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:16px;margin-top:32px}\n  .tr-item{position:relative;margin:0;border-radius:18px;overflow:hidden;border:1px solid var(--border-dark);background:var(--ink-900);aspect-ratio:3/4}\n  .tr-item img{width:100%;height:100%;object-fit:cover}\n  .tr-tag{position:absolute;top:12px;left:12px;padding:5px 12px;border-radius:999px;font-weight:700;font-size:11px;letter-spacing:.12em;text-transform:uppercase;background:rgba(6,6,7,.72);color:var(--gray-300);backdrop-filter:blur(4px)}\n  .tr-tag--after{background:var(--grad-gold);color:var(--ink-950)}\n  .tr-videos{display:grid;grid-template-columns:1fr 1fr;gap:16px;margin-top:16px}\n  .tr-video{margin:0;border-radius:18px;overflow:hidden;border:1px solid var(--border-dark);background:#000}\n  .tr-video video{width:100%;display:block;aspect-ratio:9/16;object-fit:cover;max-height:620px}\n  .tr-note{display:inline-flex;align-items:center;gap:8px;margin-top:32px;font-size:14px;color:var(--gray-400)}\n  @media(max-width:900px){.tr-grid{grid-template-columns:1fr 1fr}}\n  @media(max-width:540px){.tr-grid,.tr-videos{grid-template-columns:1fr}}\n\n  /* Responsive — mobile-first cascade */\n  @media (max-width: 1024px) {\n    .nos-grid, .pq-grid, .con-grid { grid-template-columns: 1fr 1fr !important; }\n    .foot-grid { grid-template-columns: 1.4fr 1fr 1fr !important; }\n  }\n  @media (max-width: 900px) {\n    .nav-links, .nav-cta, .util-hide { display: none !important; }\n    .nav-burger { display: inline-flex !important; }\n    .svc-grid, .gal-grid, .step-grid { grid-template-columns: repeat(2, 1fr) !important; }\n  }\n  @media (max-width: 760px) {\n    .hero-grid { grid-template-columns: 1fr !important; gap: 36px !important; padding-block: 48px 56px !important; }\n    .hero-copy { max-width: none !important; }\n    .hero-media { max-width: 420px; margin-inline: auto; width: 100%; }\n    .nos-grid, .pq-grid, .con-grid { grid-template-columns: 1fr !important; }\n    .pq-media { order: 2; }\n    .foot-grid { grid-template-columns: 1fr 1fr !important; }\n    .fab-label { display: none !important; }\n  }\n  @media (max-width: 540px) {\n    .svc-grid, .step-grid, .gal-grid, .val-grid, .form-row, .foot-grid { grid-template-columns: 1fr !important; }\n    .foot-grid img { width: 168px !important; }\n    .nav-logo { width: 126px !important; }\n    .foot-bottom { flex-direction: column; align-items: flex-start; gap: 8px; }\n  }\n  image-slot { --is-bg: var(--ink-900); }\n";
