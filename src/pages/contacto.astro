---
import { Fragment } from 'astro/jsx-runtime';
import '../styles/styles.css';
const WA = '56962183204';
const IG = 'https://www.instagram.com/halex.cl';
const FB = 'https://web.facebook.com/profile.php?id=61593272812619';
const EMAIL = 'contacto@halex.cl';
const links = [
  { label: 'Instagram', sub: '@halex.cl', href: IG, icon: 'ig' },
  { label: 'Facebook', sub: 'HALEX', href: FB, icon: 'fb' },
  { label: 'Cotizar por WhatsApp', sub: 'Respuesta rápida · Sin compromiso', href: `https://wa.me/${WA}?text=${encodeURIComponent('Hola HALEX, quiero cotizar un trabajo.')}`, icon: 'wa', primary: true },
  { label: 'Ver nuestros servicios', sub: 'Techumbres, gasfitería, pintura y más', href: '/#servicios', icon: 'tools' },
  { label: 'Trabajos reales', sub: 'Fotos y videos de obra', href: '/#trabajos', icon: 'camera' },
  { label: EMAIL, sub: 'Escríbenos por correo', href: `mailto:${EMAIL}`, icon: 'mail' },
  { label: '+56 9 6218 3204', sub: 'Llámanos directo', href: `tel:+${WA}`, icon: 'phone' },
];
---
<!DOCTYPE html>
<html lang="es">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<!-- Google tag (gtag.js) -->
<script is:inline async src="https://www.googletagmanager.com/gtag/js?id=AW-18520884552"></script>
<script is:inline>
  window.dataLayer = window.dataLayer || [];
  function gtag(){dataLayer.push(arguments);}
  gtag('js', new Date());
  gtag('config', 'AW-18520884552');
</script>
<!-- Conversiones HALEX: se disparan solo al hacer clic -->
<script is:inline>
(function(){
  var CONV = {
    whatsapp: 'AW-18520884552/X7KECLyt4qMdEMiKuf9E', // Solicitar cotización
    correo: ''  // PENDIENTE: pegar aquí la etiqueta de la conversión "Clic en correo" (AW-18520884552/xxxx)
  };
  function halexConv(tipo){
    var id = CONV[tipo];
    if (!id || typeof gtag !== 'function') return;
    gtag('event', 'conversion', { send_to: id });
  }
  window.halexConv = halexConv;
  document.addEventListener('click', function(e){
    var a = e.target.closest && e.target.closest('a[href]');
    if (!a) return;
    var h = a.getAttribute('href') || '';
    if (/wa\.me\/|api\.whatsapp\.com/.test(h)) halexConv('whatsapp');
    else if (/^mailto:/i.test(h)) halexConv('correo');
  }, true);
})();
</script>
<title>Contacto — HALEX</title>
<meta name="description" content="Contacta a HALEX: WhatsApp, Instagram, Facebook y correo. Obras menores en construcción y servicios para tu hogar o negocio.">
<meta name="robots" content="noindex">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Archivo:wght@500;600;700;800;900&family=Hanken+Grotesk:wght@400;500;600;700&display=swap">
<style>
*{box-sizing:border-box}
body{margin:0;min-height:100vh;background:var(--ink-950);color:#fff;font-family:var(--font-body);display:flex;flex-direction:column;align-items:center;justify-content:flex-start;padding:48px 20px 40px;position:relative;overflow-x:hidden}
.bg{position:fixed;inset:0;pointer-events:none;overflow:hidden}
.bg-photo{position:absolute;inset:0;background-image:url("/assets/hero-equipo.jpg");background-size:cover;background-position:center 22%;opacity:.16;filter:grayscale(.35)}
.bg-veil{position:absolute;inset:0;background:linear-gradient(180deg, rgba(6,6,7,.62) 0%, rgba(6,6,7,.9) 46%, var(--ink-950) 100%)}
.bg-glow{position:absolute;left:50%;top:-12%;width:min(760px,150vw);aspect-ratio:1;transform:translateX(-50%);background:radial-gradient(circle, rgba(232,182,46,.2) 0%, rgba(232,182,46,.06) 42%, transparent 68%);animation:breathe 9s ease-in-out infinite}
.bg-orb{position:absolute;border-radius:50%;filter:blur(46px);opacity:.5}
.bg-orb--1{width:230px;height:230px;left:-70px;top:26%;background:radial-gradient(circle, rgba(232,182,46,.3), transparent 70%);animation:drift1 17s ease-in-out infinite}
.bg-orb--2{width:280px;height:280px;right:-90px;top:56%;background:radial-gradient(circle, rgba(232,182,46,.18), transparent 70%);animation:drift2 21s ease-in-out infinite}
.bg-vignette{position:absolute;inset:0;background:radial-gradient(ellipse at 50% 40%, transparent 42%, rgba(6,6,7,.72) 100%)}
.bg-dots{position:absolute;inset:0;background-image:radial-gradient(circle at 1px 1px, rgba(255,255,255,.05) 1px, transparent 0);background-size:22px 22px}
@keyframes breathe{0%,100%{opacity:.85;transform:translateX(-50%) scale(1)}50%{opacity:1;transform:translateX(-50%) scale(1.1)}}
@keyframes drift1{0%,100%{transform:translate(0,0)}50%{transform:translate(40px,-34px)}}
@keyframes drift2{0%,100%{transform:translate(0,0)}50%{transform:translate(-46px,30px)}}
@keyframes riseIn{from{opacity:0;transform:translateY(18px)}to{opacity:1;transform:translateY(0)}}
.wrap{position:relative;width:100%;max-width:440px;display:flex;flex-direction:column;align-items:center;gap:32px}
.brand{display:flex;flex-direction:column;align-items:center;gap:18px;text-align:center;animation:riseIn .7s cubic-bezier(.22,1,.36,1) both}
.brand img{width:210px;max-width:76vw;height:auto;display:block;filter:drop-shadow(0 6px 26px rgba(232,182,46,.22))}
.tagline{font-size:15px;line-height:1.55;color:var(--gray-300);margin:0;max-width:340px;text-wrap:pretty}
.list{display:flex;flex-direction:column;gap:12px;width:100%}
.item{position:relative;overflow:hidden;display:flex;align-items:center;gap:14px;padding:16px 18px;border-radius:16px;border:1px solid var(--border-dark);background:rgba(18,18,20,.62);backdrop-filter:blur(8px);color:#fff;text-decoration:none;transition:border-color .22s,background .22s,transform .22s,box-shadow .22s;animation:riseIn .6s cubic-bezier(.22,1,.36,1) both}
.item:nth-child(1){animation-delay:.06s}
.item:nth-child(2){animation-delay:.12s}
.item:nth-child(3){animation-delay:.18s}
.item:nth-child(4){animation-delay:.24s}
.item:nth-child(5){animation-delay:.3s}
.item:nth-child(6){animation-delay:.36s}
.item:nth-child(7){animation-delay:.42s}
.item::after{content:"";position:absolute;top:0;left:-70%;width:45%;height:100%;background:linear-gradient(100deg, transparent, rgba(255,255,255,.13), transparent);transform:skewX(-18deg);transition:left .55s ease;pointer-events:none}
.item:hover::after{left:125%}
.item:hover{border-color:var(--border-gold);background:rgba(232,182,46,.11);transform:translateY(-2px);box-shadow:0 10px 30px -14px rgba(232,182,46,.35)}
.item:active{transform:translateY(0)}
.item--wa{background:var(--whatsapp);border-color:transparent;box-shadow:var(--glow-whatsapp)}
.item--wa:hover{background:#1eb355;border-color:transparent;transform:translateY(-2px)}
.ic{position:relative;flex-shrink:0;width:44px;height:44px;display:inline-flex;align-items:center;justify-content:center;border-radius:12px;background:var(--grad-gold);color:var(--ink-950);transition:transform .28s cubic-bezier(.22,1,.36,1)}
.item:hover .ic{transform:scale(1.08) rotate(-3deg)}
.item--wa .ic::before{content:"";position:absolute;inset:0;border-radius:12px;border:1.5px solid rgba(255,255,255,.7);animation:waPulse 2.4s cubic-bezier(.22,1,.36,1) infinite}
@keyframes waPulse{0%{transform:scale(1);opacity:.8}70%{transform:scale(1.5);opacity:0}100%{transform:scale(1.5);opacity:0}}
.item--wa .ic{background:rgba(255,255,255,.16);color:#fff}
.txt{display:flex;flex-direction:column;gap:2px;min-width:0}
.txt b{font-family:var(--font-display);font-weight:700;font-size:16px;letter-spacing:-.01em;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.txt span{font-size:13px;color:var(--gray-400)}
.item--wa .txt span{color:rgba(255,255,255,.8)}
.arrow{margin-left:auto;flex-shrink:0;color:var(--gray-500);transition:color .22s,transform .22s}
.item:hover .arrow{color:var(--gold-500);transform:translateX(3px)}
.item--wa .arrow{color:rgba(255,255,255,.75)}
.item--wa:hover .arrow{color:#fff}
.hours{display:flex;flex-direction:column;align-items:center;gap:6px;text-align:center;padding-top:8px;animation:riseIn .6s cubic-bezier(.22,1,.36,1) .5s both}
.hours b{font-family:var(--font-body);font-weight:700;font-size:11px;letter-spacing:.16em;text-transform:uppercase;color:var(--gold-500);display:inline-flex;align-items:center;gap:8px}
.hours b::before,.hours b::after{content:"";width:26px;height:1px;background:linear-gradient(90deg,transparent,var(--gold-700))}
.hours b::after{background:linear-gradient(90deg,var(--gold-700),transparent)}
.dot-live{width:7px;height:7px;border-radius:50%;background:var(--whatsapp);animation:live 2s ease-out infinite;display:inline-block;margin-right:7px;vertical-align:middle}
@keyframes live{0%{box-shadow:0 0 0 0 rgba(37,211,102,.55)}70%{box-shadow:0 0 0 9px rgba(37,211,102,0)}100%{box-shadow:0 0 0 0 rgba(37,211,102,0)}}
.ticker{width:100%;overflow:hidden;border-block:1px solid var(--border-dark);padding:11px 0;mask-image:linear-gradient(90deg,transparent,#000 12%,#000 88%,transparent);-webkit-mask-image:linear-gradient(90deg,transparent,#000 12%,#000 88%,transparent);animation:riseIn .6s cubic-bezier(.22,1,.36,1) .56s both}
.ticker-track{display:flex;width:max-content;animation:slide 26s linear infinite}
.ticker span{font-family:var(--font-body);font-weight:600;font-size:11.5px;letter-spacing:.15em;text-transform:uppercase;color:var(--gray-400);padding:0 16px;white-space:nowrap;display:inline-flex;align-items:center;gap:16px}
.ticker span::after{content:"";width:4px;height:4px;border-radius:50%;background:var(--gold-700)}
@keyframes slide{from{transform:translateX(0)}to{transform:translateX(-50%)}}
.hours span{font-size:14px;color:var(--gray-300)}
.foot{font-size:12px;color:var(--gray-500);text-align:center;margin:0}
.foot a{color:var(--gray-400)}
.foot a:hover{color:var(--gold-500)}
@media(max-width:380px){.item{padding:14px 15px;gap:12px}.ic{width:40px;height:40px}.txt b{font-size:15px}}
@media(prefers-reduced-motion:reduce){*{animation:none !important;transition:none !important}}
</style>
</head>
<body>
<div class="bg" aria-hidden="true">
  <div class="bg-photo"></div>
  <div class="bg-veil"></div>
  <div class="bg-glow"></div>
  <div class="bg-orb bg-orb--1"></div>
  <div class="bg-orb bg-orb--2"></div>
  <div class="bg-dots"></div>
  <div class="bg-vignette"></div>
</div>
<div class="wrap">
  <div class="brand">
    <img src="/assets/halex-logo.png" alt="HALEX — Obras menores en construcción y servicios">
    <p class="tagline">Reparaciones, mantenciones y mejoras para tu hogar o negocio. Elige por dónde quieres contactarnos.</p>
  </div>

  <div class="list">
    {links.map((l) => (
      <a class={'item' + (l.primary ? ' item--wa' : '')} href={l.href} target={l.href.startsWith('http') ? '_blank' : undefined} rel={l.href.startsWith('http') ? 'noopener noreferrer' : undefined}>
        <span class="ic">
          {l.icon === 'wa' && <Fragment set:html={`<svg width="22" height="22" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M.057 24l1.687-6.163a11.867 11.867 0 01-1.587-5.945C.16 5.335 5.495 0 12.05 0a11.817 11.817 0 018.413 3.488 11.824 11.824 0 013.48 8.414c-.003 6.557-5.338 11.892-11.893 11.892a11.9 11.9 0 01-5.688-1.448L.057 24zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884a9.86 9.86 0 001.51 5.26l-.999 3.648 3.477-.917zm11.387-5.464c-.074-.124-.272-.198-.57-.347-.297-.149-1.758-.868-2.031-.967-.272-.099-.47-.149-.669.149-.198.297-.768.967-.941 1.165-.173.198-.347.223-.644.074-.297-.149-1.255-.462-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.297-.347.446-.521.151-.172.2-.296.3-.495.099-.198.05-.372-.025-.521-.075-.148-.669-1.611-.916-2.206-.242-.579-.487-.501-.669-.51l-.57-.01c-.198 0-.52.074-.792.372s-1.04 1.016-1.04 2.479 1.065 2.876 1.213 3.074c.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.872.118.571-.085 1.758-.719 2.006-1.413.247-.694.247-1.289.173-1.413z"/></svg>`} />}
          {l.icon === 'tools' && <Fragment set:html={`<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14.7 6.3a4 4 0 0 0-5.3 5.1L3 17.8 6.2 21l6.4-6.4a4 4 0 0 0 5.1-5.3l-2.5 2.5-2.3-.6-.6-2.3 2.4-2.6z"/><path d="m15.5 14.5 4.5 4.5"/></svg>`} />}
          {l.icon === 'camera' && <Fragment set:html={`<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 8a2 2 0 0 1 2-2h2l1.5-2h7L17 6h2a2 2 0 0 1 2 2v10a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/><circle cx="12" cy="13" r="3.5"/></svg>`} />}
          {l.icon === 'ig' && <Fragment set:html={`<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2.5" y="2.5" width="19" height="19" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.3" cy="6.7" r="1.1" fill="currentColor" stroke="none"/></svg>`} />}
          {l.icon === 'fb' && <Fragment set:html={`<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M15 8h-2a2 2 0 0 0-2 2v12M8 13h6"/></svg>`} />}
          {l.icon === 'mail' && <Fragment set:html={`<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="4" width="20" height="16" rx="2"/><path d="m2 6 10 7L22 6"/></svg>`} />}
          {l.icon === 'phone' && <Fragment set:html={`<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.9v3a2 2 0 0 1-2.2 2 19.8 19.8 0 0 1-8.6-3 19.5 19.5 0 0 1-6-6 19.8 19.8 0 0 1-3-8.6A2 2 0 0 1 4.1 2h3a2 2 0 0 1 2 1.7c.1.9.3 1.8.6 2.6a2 2 0 0 1-.4 2.1L8 9.8a16 16 0 0 0 6 6l1.4-1.3a2 2 0 0 1 2.1-.4c.8.3 1.7.5 2.6.6a2 2 0 0 1 1.7 2z"/></svg>`} />}
        </span>
        <span class="txt"><b>{l.label}</b><span>{l.sub}</span></span>
        <span class="arrow"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 6l6 6-6 6"/></svg></span>
      </a>
    ))}
  </div>

  <div class="ticker">
    <div class="ticker-track">
      <span>Techumbres y goteras</span><span>Gasfitería</span><span>Pintura</span><span>Electricidad menor</span><span>Mantenciones</span><span>Techumbres y goteras</span><span>Gasfitería</span><span>Pintura</span><span>Electricidad menor</span><span>Mantenciones</span>
    </div>
  </div>

  <div class="hours">
    <b>Horario de atención</b>
    <span><i class="dot-live"></i>Lunes a sábado · 9:00 – 19:00</span>
    <span>Santiago y alrededores</span>
  </div>

  <p class="foot">© 2026 HALEX · <a href="/">Ver sitio completo</a></p>
</div>
</body>
</html>
