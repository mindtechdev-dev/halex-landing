<script is:inline>
(function(){
  var f = document.getElementById('postular'), err = document.getElementById('p-err');
  f.addEventListener('submit', function(e){
    e.preventDefault();
    var nom = f.nombre.value.trim(), com = f.comuna.value.trim(), tel = f.telefono.value.trim();
    var veh = f.querySelector('input[name=vehiculo]:checked');
    var esp = Array.prototype.map.call(f.querySelectorAll('input[name=esp]:checked'), function(i){ return i.value; });
    var faltan = [];
    if (!nom) faltan.push('nombre'); if (!com) faltan.push('comuna'); if (!tel) faltan.push('teléfono');
    if (!veh) faltan.push('vehículo propio'); if (!esp.length) faltan.push('al menos una especialidad');
    if (faltan.length) { err.textContent = 'Falta completar: ' + faltan.join(', ') + '.'; err.classList.add('show'); return; }
    err.classList.remove('show');
    var msg = 'Hola HALEX, quiero postular para trabajar con ustedes.\n\nNombre: ' + nom + '\nComuna: ' + com + '\nTeléfono: ' + tel + '\nVehículo propio: ' + veh.value + '\nEspecialidades: ' + esp.join(', ');
    window.open('https://wa.me/56962183204?text=' + encodeURIComponent(msg), '_blank');
  });
})();
</script>
