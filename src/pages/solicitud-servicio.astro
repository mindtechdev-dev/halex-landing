<div class="field"><label class="lbl" for="s-comuna">Comuna <span class="req">*</span></label><select class="inp" id="s-comuna" name="comuna"><option value="">Elija comuna</option><option>Cerrillos</option><option>Cerro Navia</option><option>Chicureo</option><option>Colina</option><option>Conchalí</option><option>El Bosque</option><option>Estación Central</option><option>Huechuraba</option><option>Independencia</option><option>La Cisterna</option><option>La Florida</option><option>La Granja</option><option>La Pintana</option><option>La Reina</option><option>Las Condes</option><option>Lo Barnechea</option><option>Lo Espejo</option><option>Lo Prado</option><option>Macul</option><option>Maipú</option><option>Ñuñoa</option><option>Pedro Aguirre Cerda</option><option>Peñalolén</option><option>Providencia</option><option>Pudahuel</option><option>Puente Alto</option><option>Quilicura</option><option>Quinta Normal</option><option>Recoleta</option><option>Renca</option><option>San Bernardo</option><option>San Joaquín</option><option>San Miguel</option><option>San Ramón</option><option>Santiago Centro</option><option>Vitacura</option><option>Otra comuna</option></select></div>
<div class="field"><label class="lbl" for="s-servicio">Servicio que necesita <span class="req">*</span></label><input class="inp" id="s-servicio" name="servicio" list="s-servicios" placeholder="Servicio que necesita"><datalist id="s-servicios"><option value="Gasfitería"></option><option value="Electricidad SEC"></option><option value="Destape de alcantarillado"></option><option value="Detección de fugas"></option><option value="Techumbres y goteras"></option><option value="Pintura"></option><option value="Portones eléctricos"></option><option value="Mantenciones generales"></option></datalist></div>
<div class="field"><label class="lbl" for="s-fecha">¿Para cuándo lo necesita?</label><input class="inp" id="s-fecha" name="fecha" type="date"></div>
