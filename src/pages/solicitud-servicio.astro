<script is:inline>
(function(){
  var f = document.getElementById('solicitud'), err = document.getElementById('s-err');
  Array.prototype.forEach.call(document.querySelectorAll('.zbtn'), function(b){
    b.addEventListener('click', function(){ f.comuna.value = b.getAttribute('data-comuna'); window.scrollTo({ top: f.getBoundingClientRect().top + window.scrollY - 100, behavior: 'smooth' }); f.servicio.focus({ preventScroll: true }); });
  });
  f.addEventListener('submit', function(e){
    e.preventDefault();
    var v = function(n){ return f[n].value.trim(); };
    var faltan = [];
    if (!v('correo')) faltan.push('correo'); if (!v('nombre')) faltan.push('nombre'); if (!v('telefono')) faltan.push('teléfono');
    if (!v('comuna')) faltan.push('comuna'); if (!v('servicio')) faltan.push('servicio');
    if (faltan.length) { err.textContent = 'Falta completar: ' + faltan.join(', ') + '.'; err.classList.add('show'); return; }
    err.classList.remove('show');
    var fecha = v('fecha') ? v('fecha').split('-').reverse().join('/') : 'A coordinar';
    var msg = 'Hola HALEX, quiero solicitar un servicio.\n\nNombre: ' + v('nombre') + '\nCorreo: ' + v('correo') + '\nTeléfono: ' + v('telefono') + '\nComuna: ' + v('comuna') + '\nServicio: ' + v('servicio') + '\nPara cuándo: ' + fecha;
    if (window.halexConv) window.halexConv('whatsapp');
    window.open('https://wa.me/56962183204?text=' + encodeURIComponent(msg), '_blank');
  });
})();
</script>
